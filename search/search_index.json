{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"CMQ's Notes","text":"<p>\u6b22\u8fce\u6765\u5230\u6211\u7684\u4e2a\u4eba\u77e5\u8bc6\u5e93\u3002</p>"},{"location":"#_1","title":"\u8fd9\u91cc\u4ee5\u540e\u53ef\u4ee5\u8bb0\u5f55","text":"<ul> <li>Linux</li> <li>Docker</li> <li>Git</li> <li>Python</li> <li>\u7f51\u7edc</li> <li>\u5404\u79cd\u6298\u817e\u8bb0\u5f55</li> </ul>"},{"location":"#_2","title":"\u6d4b\u8bd5\u4ee3\u7801","text":"<p>```bash sudo apt update docker ps</p>"},{"location":"mkdocs_auto_nav_notes/","title":"MkDocs Material \u81ea\u52a8\u6839\u636e\u76ee\u5f55\u751f\u6210\u5bfc\u822a","text":""},{"location":"mkdocs_auto_nav_notes/#_1","title":"\u76ee\u6807","text":"<p>\u8ba9 MkDocs \u81ea\u52a8\u626b\u63cf <code>docs/</code> \u76ee\u5f55\u4e2d\u7684 Markdown \u6587\u4ef6\u5e76\u751f\u6210\u5bfc\u822a\uff0c\u8fd9\u6837\u4ee5\u540e\u65b0\u589e\u6587\u7ae0\u65f6\uff0c\u4e0d\u9700\u8981\u6bcf\u6b21\u624b\u52a8\u4fee\u6539 <code>mkdocs.yml</code> \u91cc\u7684 <code>nav:</code>\u3002</p>"},{"location":"mkdocs_auto_nav_notes/#1-mkdocsyml-nav","title":"1. \u5220\u9664 <code>mkdocs.yml</code> \u4e2d\u624b\u52a8\u914d\u7f6e\u7684 <code>nav</code>","text":"<p>\u8fdb\u5165\u9879\u76ee\u76ee\u5f55\uff1a</p> <pre><code>cd /home/cmq/workspace/projects/notes\n</code></pre> <p>\u5efa\u8bae\u5148\u5907\u4efd\uff1a</p> <pre><code>cp mkdocs.yml mkdocs.yml.backup\n</code></pre> <p>\u5982\u679c <code>nav:</code> \u4f4d\u4e8e\u6587\u4ef6\u6700\u540e\uff0c\u53ef\u4ee5\u6267\u884c\uff1a</p> <pre><code>sed -i '/^nav:/,$d' mkdocs.yml\n</code></pre> <p>\u68c0\u67e5\uff1a</p> <pre><code>tail -n 15 mkdocs.yml\n</code></pre> <p>\u786e\u8ba4\u5df2\u7ecf\u6ca1\u6709\u7c7b\u4f3c\u4e0b\u9762\u7684\u5185\u5bb9\uff1a</p> <pre><code>nav:\n  - \u9996\u9875: index.md\n</code></pre> <p>MkDocs \u5728\u6ca1\u6709\u624b\u52a8 <code>nav:</code> \u65f6\uff0c\u4f1a\u81ea\u52a8\u626b\u63cf <code>docs/</code> \u76ee\u5f55\u4e2d\u7684 Markdown \u6587\u4ef6\u5e76\u751f\u6210\u5bfc\u822a\u3002</p>"},{"location":"mkdocs_auto_nav_notes/#2","title":"2. \u6309\u76ee\u5f55\u5206\u7c7b\u6587\u7ae0","text":"<p>\u63a8\u8350\u7ed3\u6784\uff1a</p> <pre><code>docs/\n\u251c\u2500\u2500 index.md\n\u251c\u2500\u2500 linux/\n\u2502   \u251c\u2500\u2500 index.md\n\u2502   \u251c\u2500\u2500 ssh.md\n\u2502   \u2514\u2500\u2500 zsh.md\n\u251c\u2500\u2500 docker/\n\u2502   \u251c\u2500\u2500 index.md\n\u2502   \u2514\u2500\u2500 compose.md\n\u2514\u2500\u2500 python/\n    \u251c\u2500\u2500 index.md\n    \u2514\u2500\u2500 venv.md\n</code></pre> <p>\u521b\u5efa\u5206\u7c7b\u76ee\u5f55\uff1a</p> <pre><code>mkdir -p docs/linux docs/docker docs/python\n</code></pre>"},{"location":"mkdocs_auto_nav_notes/#3","title":"3. \u65b0\u589e\u6587\u7ae0","text":"<p>\u4f8b\u5982\u521b\u5efa Zsh \u7b14\u8bb0\uff1a</p> <pre><code>nano docs/linux/zsh.md\n</code></pre> <p>\u5185\u5bb9\u793a\u4f8b\uff1a</p> <pre><code># Zsh\n\n\u8fd9\u91cc\u5199 Zsh \u76f8\u5173\u7b14\u8bb0\u3002\n</code></pre> <p>\u521b\u5efa SSH \u7b14\u8bb0\uff1a</p> <pre><code>nano docs/linux/ssh.md\n</code></pre> <p>\u5185\u5bb9\u793a\u4f8b\uff1a</p> <pre><code># SSH\n\n\u8fd9\u91cc\u5199 SSH \u76f8\u5173\u7b14\u8bb0\u3002\n</code></pre> <p>\u521b\u5efa Docker Compose \u7b14\u8bb0\uff1a</p> <pre><code>nano docs/docker/compose.md\n</code></pre> <p>\u5185\u5bb9\u793a\u4f8b\uff1a</p> <pre><code># Docker Compose\n\n\u8fd9\u91cc\u5199 Docker Compose \u76f8\u5173\u7b14\u8bb0\u3002\n</code></pre> <p>\u4ee5\u540e\u65b0\u589e\u6587\u7ae0\u65f6\uff0c\u53ea\u9700\u8981\u5728\u5408\u9002\u7684\u76ee\u5f55\u4e2d\u65b0\u5efa <code>.md</code> \u6587\u4ef6\u5373\u53ef\u3002</p>"},{"location":"mkdocs_auto_nav_notes/#4-indexmd","title":"4. \u6bcf\u4e2a\u5206\u7c7b\u5efa\u8bae\u521b\u5efa <code>index.md</code>","text":"<p>\u4f8b\u5982\uff1a</p> <pre><code>nano docs/linux/index.md\n</code></pre> <p>\u5185\u5bb9\uff1a</p> <pre><code># Linux\n\n\u8fd9\u91cc\u8bb0\u5f55\u6211\u7684 Linux \u76f8\u5173\u7b14\u8bb0\u3002\n</code></pre> <p>\u8fd9\u6837\u8fdb\u5165 <code>Linux</code> \u5206\u7c7b\u65f6\uff0c\u4f1a\u6709\u4e00\u4e2a\u5206\u7c7b\u9996\u9875\u3002</p> <p>\u540c\u7406\uff1a</p> <pre><code>nano docs/docker/index.md\nnano docs/python/index.md\n</code></pre>"},{"location":"mkdocs_auto_nav_notes/#5","title":"5. \u672c\u5730\u9884\u89c8","text":"<p>\u542f\u7528\u865a\u62df\u73af\u5883\uff1a</p> <pre><code>cd /home/cmq/workspace/projects/notes\nsource .venv/bin/activate\n</code></pre> <p>\u542f\u52a8 MkDocs\uff1a</p> <pre><code>mkdocs serve\n</code></pre> <p>\u5982\u679c\u9700\u8981\u4ece\u5c40\u57df\u7f51\u5176\u4ed6\u7535\u8111\u8bbf\u95ee\uff1a</p> <pre><code>mkdocs serve -a 0.0.0.0:8000\n</code></pre>"},{"location":"mkdocs_auto_nav_notes/#6-github-pages","title":"6. \u66f4\u65b0 GitHub Pages","text":"<p>\u786e\u8ba4\u672c\u5730\u663e\u793a\u6b63\u5e38\u540e\uff1a</p> <pre><code>git add .\ngit commit -m \"\u66f4\u65b0\u7b14\u8bb0\"\ngit push\n</code></pre> <p>GitHub Actions \u4f1a\u81ea\u52a8\u91cd\u65b0\u6784\u5efa\u5e76\u90e8\u7f72\u7f51\u7ad9\u3002</p> <p>\u7f51\u7ad9\u5730\u5740\uff1a</p> <pre><code>https://inibd.github.io/notes/\n</code></pre>"},{"location":"mkdocs_auto_nav_notes/#7","title":"7. \u4ee5\u540e\u65b0\u589e\u6587\u7ae0\u7684\u56fa\u5b9a\u6d41\u7a0b","text":"<pre><code>\u521b\u5efa\u6216\u4fee\u6539 .md\n        \u2193\n\u672c\u5730 mkdocs serve \u9884\u89c8\n        \u2193\ngit add .\n        \u2193\ngit commit -m \"\u66f4\u65b0\u7b14\u8bb0\"\n        \u2193\ngit push\n        \u2193\nGitHub Pages \u81ea\u52a8\u66f4\u65b0\n</code></pre>"},{"location":"mkdocs_auto_nav_notes/#8","title":"8. \u6ce8\u610f\u4e8b\u9879","text":""},{"location":"mkdocs_auto_nav_notes/#_2","title":"\u81ea\u52a8\u5bfc\u822a\u7684\u6392\u5e8f","text":"<p>MkDocs \u9ed8\u8ba4\u4f1a\u6309\u7167\u6587\u4ef6\u540d/\u76ee\u5f55\u540d\u81ea\u52a8\u751f\u6210\u5bfc\u822a\uff0c\u56e0\u6b64\u53ef\u4ee5\u901a\u8fc7\u6587\u4ef6\u540d\u63a7\u5236\u4e00\u5b9a\u7a0b\u5ea6\u7684\u987a\u5e8f\u3002</p> <p>\u5982\u679c\u4ee5\u540e\u9700\u8981\uff1a</p> <ul> <li>\u81ea\u5b9a\u4e49\u76ee\u5f55\u663e\u793a\u540d\u79f0</li> <li>\u81ea\u5b9a\u4e49\u6392\u5e8f</li> <li>\u9690\u85cf\u67d0\u4e9b\u9875\u9762</li> <li>\u66f4\u7075\u6d3b\u5730\u63a7\u5236\u5bfc\u822a</li> </ul> <p>\u53ef\u4ee5\u8003\u8651\u5b89\u88c5 <code>mkdocs-awesome-nav</code> \u63d2\u4ef6\u3002</p>"},{"location":"mkdocs_auto_nav_notes/#_3","title":"\u6587\u4ef6\u540d\u548c\u6807\u9898","text":"<p>\u6587\u4ef6\u540d\uff1a</p> <pre><code>docs/linux/zsh.md\n</code></pre> <p>\u9875\u9762\u6807\u9898\u5efa\u8bae\u5728\u6587\u4ef6\u7b2c\u4e00\u884c\u5199\uff1a</p> <pre><code># Zsh\n</code></pre> <p>\u6587\u4ef6\u540d\u51b3\u5b9a\u8def\u5f84\uff0cMarkdown \u4e00\u7ea7\u6807\u9898\u51b3\u5b9a\u9875\u9762\u663e\u793a\u6807\u9898\u3002</p>"},{"location":"linux/zsh/","title":"Zsh \u914d\u7f6e\u8bb0\u5f55","text":""},{"location":"linux/zsh/#_1","title":"\u5b89\u88c5","text":"<p>```bash sudo apt install zsh</p>"}]}